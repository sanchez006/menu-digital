@api = http://localhost:3000/api

### Primero inicia sesión (cambia los datos por los de tu superadmin)
# @name login
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "tu_correo@ejemplo.com",
  "password": "tu_contraseña"
}

###
@token = {{login.response.body.token}}

### Listar negocios
GET {{api}}/negocios
Authorization: Bearer {{token}}

### Crear negocio (debe responder 201)
POST {{api}}/negocios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Licuados Don Pepe",
  "slug": "licuados-don-pepe",
  "whatsapp": "+50287654321"
}

### Ver un negocio
GET {{api}}/negocios/1
Authorization: Bearer {{token}}

### Editar solo el color
PATCH {{api}}/negocios/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "color_primario": "#2E7D32"
}

### Desactivar negocio
DELETE {{api}}/negocios/1
Authorization: Bearer {{token}}

### ---------- Pruebas de errores ----------

### Sin token (debe responder 401)
GET {{api}}/negocios

### Slug repetido (debe responder 409)
POST {{api}}/negocios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Otra tienda",
  "slug": "licuados-don-pepe"
}

### Datos inválidos (debe responder 400)
POST {{api}}/negocios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "X",
  "slug": "Mi Tienda",
  "color_primario": "verde"
}

### Negocio que no existe (debe responder 404)
GET {{api}}/negocios/9999
Authorization: Bearer {{token}}
